<div class="post-preview">
  <div class="post-meta">
    <a href="{{ path('web_profile_view', {username: article.author.username}) }}"><img src="{{ article.author.image|default('https://static.productionready.io/images/smiley-cyrus.jpg') }}" alt="{{ article.author.username }}"></a>
    <div class="info">
      <a href="{{ path('web_profile_view', {username: article.author.username}) }}" class="author">{{ article.author.username }}</a>
      <span class="date">{{ article.createdAt|format_date(locale='en', pattern='MMMM d') }}</span>
    </div>
    {% if app.user %}
      <form method="post" action="{{ path('web_article_favorite', {slug: article.slug}) }}" class="pull-xs-right">
        <input type="hidden" name="_token" value="{{ csrf_token('favorite' ~ article.slug) }}">
        <input type="hidden" name="op" value="{{ favorited ? 'unfavorite' : 'favorite' }}">
        <button class="btn btn-outline-primary btn-sm" type="submit">
          <i class="ion-heart"></i>&nbsp;{{ article.favorites.count }}
        </button>
      </form>
    {% else %}
      <a class="btn btn-outline-primary btn-sm pull-xs-right" href="{{ path('web_login') }}">
        <i class="ion-heart"></i>&nbsp;{{ article.favorites.count }}
      </a>
    {% endif %}
  </div>
  <a href="{{ path('web_article_show', {slug: article.slug}) }}" class="preview-link">
    <h1>{{ article.title }}</h1>
    <p>{{ article.description }}</p>
    <span>Read more...</span>
    <ul class="tag-list">
      {% for tag in article.tags %}
        <li class="label label-default tag-pill">{{ tag.name }}</li>
      {% endfor %}
    </ul>
  </a>
</div>
